# 复制成 server.env 再填自己的（server.env 不要提交到仓库）
#
# 用法：
#   cp server.env.example server.env   &&   vi server.env
#   bash upload-to-server.sh

# 服务器 SSH 地址（用户@地址）
SERVER_SSH="ubuntu@1.2.3.4"

# SSH 端口 / 私钥（用默认密钥可以不填 SSH_KEY）
SSH_PORT=22
SSH_KEY="$HOME/.ssh/id_ed25519"

# 服务器上的博客工作目录（要和 setup-server.sh 里的 WORK 一致）
REMOTE_DIR="/srv/www/tlblog"

# 服务器上的 systemd 服务名
SERVICE="tlblog"
