# 换行符统一：这个仓库要同时在 Windows 和 Linux 上跑，混了会出事
#
#   · .sh 必须是 LF —— CRLF 的 shell 脚本在 Linux 上会报 `$'\r': command not found`
#   · .bat / .cmd / .ps1 用 CRLF（Windows 的批处理和 PowerShell 习惯）
#
# 其余交给 git 自动判断（text=auto）。
* text=auto

*.sh       text eol=lf
*.mjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.css      text eol=lf
*.py       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.service  text eol=lf
*.conf     text eol=lf
*.example  text eol=lf

*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# 二进制文件别动
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.bin      binary
*.gz       binary
*.tar      binary
